# Deployed frontend on the on-premises server (dev / test / prod): the nginx image
# (Dockerfile target `prod`). The built app has no environment-specific settings, so one image
# runs everywhere; only nginx needs to know where the backend is. Nothing here is secret.
#   docker run --env-file /opt/bcm/frontend.env -p 8080:8080 bcm-frontend
#
# nginx listens on 8080 inside the container, over plain HTTP. Put the bank's reverse proxy /
# load balancer in front for HTTPS (the backend's session cookie is HTTPS-only outside local),
# and have it pass X-Forwarded-Proto: https.

# Required: where nginx forwards /api. Scheme, host and port only; no path, no trailing slash.
#   Same Docker network as the backend container:  http://backend:8000
#   Backend on another host:                       http://10.0.0.12:8000
# nginx resolves the name once at start-up: restart the frontend if the backend's address changes.
BACKEND_URL=http://backend:8000

# Build time, not runtime: pass the git commit when building the image
# (docker build --target prod --build-arg APP_VERSION=<sha>); it ends up in /version.json.
# APP_VERSION=

# The backend's PUBLIC_BASE_URL must be this frontend's public HTTPS URL (links in emails).
