# Local development. Copy to frontend/.env:  Copy-Item .env.example.dev .env
# .env is git-ignored: never commit it. Production settings: see .env.example.production.
# The app itself has no settings: every API call is relative (/api/...), and the dev server
# proxies /api to the backend.

# --- With Docker (`docker compose up`) ---------------------------------------------------------

# The backend's host port, when it isn't 8000. Use the same value as BACKEND_HOST_PORT in
# backend/.env; compose.yaml then points the dev proxy at http://host.docker.internal:<port>.
BACKEND_HOST_PORT=8002

# --- Without Docker (`npm run dev`) ------------------------------------------------------------

# Where the dev server proxies /api (default http://localhost:8000). Match the backend's port.
# (In Docker, compose.yaml sets this itself, so this line doesn't affect the container.)
NUXT_DEV_BACKEND_URL=http://localhost:8002
BACKEND_URL=https://divisive-eleonore-pseudosacrilegiously.ngrok-free.dev
# Poll for file changes. compose.yaml sets it for Docker on Windows; rarely needed otherwise.
# CHOKIDAR_USEPOLLING=true

# --- Playwright --------------------------------------------------------------------------------

# Site under test (default http://localhost:3000).
E2E_BASE_URL=http://localhost:3000
