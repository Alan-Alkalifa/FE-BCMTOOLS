# Deployed frontend on Vercel: DEV = Preview environment, PROD = Production environment.
# Set these in Vercel > Project > Settings > Environment Variables, once per environment.
# Never put real values in this file: it is committed. The app itself has no settings;
# every API call is relative (/api/...) and middleware.ts forwards /api to BACKEND_URL.

# Required: the backend's public HTTPS URL (its ngrok domain). No path, no trailing slash.
#   Preview (DEV):     https://scallop-undefined-caviar.ngrok-free.dev
#   Production (PROD): https://divisive-eleonore-pseudosacrilegiously.ngrok-free.dev
BACKEND_URL=https://<backend>.ngrok-free.dev

# Required: the edge key the backend's ngrok policy expects in the x-bcm-edge-key header.
# Secret. Each environment has its own key: the same value as BACKEND_EDGE_KEY in that
# backend's .env and policy.yaml. A mismatch makes every /api call answer 403 Forbidden.
BACKEND_EDGE_KEY=<secret>

# Set by Vercel itself, nothing to do: VERCEL_GIT_COMMIT_SHA ends up in /version.json.
# The pipeline's GitHub secrets (VERCEL_TOKEN, VERCEL_ORG_ID, VERCEL_PROJECT_ID,
# VERCEL_AUTOMATION_BYPASS_SECRET) belong in GitHub, not here: see docs/ci-cd.md.

# The backend's PUBLIC_BASE_URL must be this frontend's public URL (links in emails):
#   PROD: https://fe-bcmtools.vercel.app
